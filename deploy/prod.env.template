# =====================================================================
# resto — white-label restaurant site (copy to prod.env at repo root).
# prod.env lives ONLY on the app VPS (chmod 600). Never in git.
#
# Per client: set brand, domain, restaurant name/slug, and real emails.
# Generate secrets:
#   SESSION_SECRET      openssl rand -base64 48
#   DB password         openssl rand -base64 24
# =====================================================================

NODE_ENV=production

# ---- Brand + domain (set before printing QR codes — URLs are baked in) --
NEXT_PUBLIC_APP_BRAND_NAME="Resto"
APP_URL=https://menu.example.com
APP_DOMAIN=menu.example.com

# ---- App image (built by `deploy/deploy.sh build`) -------------------
APP_IMAGE=resto-app:latest

# ---- Remote managed Postgres (NOT in Docker) -------------------------
DB_HOST=10.0.0.2                        # DB VPS private IP (IONOS LAN)
DB_NAME=resto_database
DB_OWNER_USER=resto_user                # database OWNER (app + migrations)
DB_OWNER_PASSWORD=change-me-owner

# ---- First-deploy provisioning (`deploy.sh seed`) -------------------
ADMIN_EMAIL=operator@example.com      # platform /admin login
ADMIN_PASSWORD=change-me-12+chars
RESTAURANT_NAME="Demo Restaurant"
RESTAURANT_SLUG=demo-restaurant         # public menu at /
OWNER_EMAIL=owner@example.com           # /dashboard login
OWNER_PASSWORD=change-me-12+chars
TEMPLATE_KEY=indian-pakistani           # starter menu (seed-menu-templates)

# ---- Sessions ---------------------------------------------------------
SESSION_SECRET=change-me-openssl-rand-base64-48

# ---- Email: Resend ----------------------------------------------------
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_change-me
EMAIL_FROM="Resto <no-reply@menu.example.com>"

# ---- Stripe (optional — or set platform keys in /admin/settings) ----
STRIPE_SECRET_KEY=sk_live_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_change-me
STRIPE_PRICE_ID_SUPPORT=price_change-me

# ---- Cloudflare cache purge (optional) -------------------------------
CLOUDFLARE_ZONE_ID=change-me
CLOUDFLARE_API_TOKEN=change-me

# ---- Image pipeline (optional — defaults are right for one VPS) -----
# Resized variants are cached on disk. Default /app/.image-cache is
# mounted as the `image_cache` volume by docker-compose.prod.yml; it is
# derived data, so it is NOT part of the backup set and can be deleted
# at any time (the next request re-encodes).
# IMAGE_CACHE_DIR=/app/.image-cache
# libvips threads. 1 keeps image encoding from starving request handling
# on a 1-2 vCPU box; raise it on a bigger machine.
# SHARP_CONCURRENCY=1

# ---- Optional observability -------------------------------------------
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# INTERNAL_METRICS_TOKEN=
