# =====================================================================
# Guesto — production environment (copy to prod.env, fill in).
# prod.env lives ONLY on the app VPS (chmod 600). Never in git.
#
# Generate secrets:
#   SESSION_SECRET      openssl rand -base64 48
#   DB password         openssl rand -base64 24
# =====================================================================

NODE_ENV=production

# ---- Domain (FINAL before any QR is printed — it's baked into them) --
NEXT_PUBLIC_APP_BRAND_NAME="Rangla Punjab"
APP_URL=https://guesto.app
APP_DOMAIN=guesto.app

# ---- App image (built by `deploy/deploy.sh build`) -------------------
APP_IMAGE=guesto-app:latest

# ---- Remote managed Postgres (NOT in Docker) -------------------------
# Single restaurant, RLS disabled: the app connects DIRECTLY to this DB
# as the owner role — no pooler, no separate least-privilege role.
DB_HOST=31.70.87.185                    # DB host / private IP
DB_NAME=rangla_database                 # your database name
DB_OWNER_USER=rangla_user               # database OWNER (app + migrations)
DB_OWNER_PASSWORD=change-me-owner
# The compose file assembles these into APP_DATABASE_URL + DATABASE_URL,
# both pointing straight at ${DB_HOST} as the owner role.

# ---- First-deploy provisioning (used by `deploy.sh seed`) -------------
# `deploy.sh release` runs the seed step on every deploy: it creates the
# operator admin, the menu templates, and — from a starter TEMPLATE_KEY — a
# PUBLISHED default menu, so a fresh deploy is NEVER a blank page. All of
# it is idempotent: once the venue (RESTAURANT_SLUG) exists, re-running is
# a no-op, so the default menu persists across deploys and later owner
# edits are never overwritten.
ADMIN_EMAIL=you@example.com                 # operator (/admin) login
ADMIN_PASSWORD=change-me-12+chars
RESTAURANT_NAME="Rangla Punjab"
RESTAURANT_SLUG=rangla-punjab               # the public menu lives at /
OWNER_EMAIL=owner@rangla-punjab.local       # restaurant (/dashboard) login
OWNER_PASSWORD=change-me-12+chars
TEMPLATE_KEY=indian-pakistani               # starter menu (see seed-menu-templates)

# ---- Sessions ---------------------------------------------------------
SESSION_SECRET=change-me-openssl-rand-base64-48

# ---- Menu photos ------------------------------------------------------
# No object store — images are written to the app's disk under
# public/uploads (mounted as the `uploads` volume in the prod compose)
# and resized on the fly by the /img route. Nothing to set here; just
# make sure the volume is backed up.

# ---- Email: Resend ----------------------------------------------------
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_change-me
EMAIL_FROM="Guesto <no-reply@guesto.app>"

# ---- Stripe (LIVE) ----------------------------------------------------
STRIPE_SECRET_KEY=sk_live_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me            # "your account" endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_change-me    # "connected accounts" endpoint
# The flat monthly operator support fee (charged to `upfront`-model
# restaurants). Create a recurring Price in your Stripe Dashboard, then
# paste its id here. Only needed if you bill the support fee in-app.
STRIPE_PRICE_ID_SUPPORT=price_change-me

# ---- Cloudflare cache purge-on-publish (recommended) -------------------
CLOUDFLARE_ZONE_ID=change-me
CLOUDFLARE_API_TOKEN=change-me

# ---- Optional observability -------------------------------------------
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# INTERNAL_METRICS_TOKEN=

# ---- Optional: read replica (Stage 3+) ---------------------------------
# DATABASE_URL_READ=postgresql://${DB_OWNER_USER}:${DB_OWNER_PASSWORD}@<replica-ip>:5432/${DB_NAME}?schema=public
