# =====================================================================
# Rangla Punjab — production environment. Copy to `prod.env` at the repo
# root ON THE APP VPS ONLY, then `chmod 600 prod.env`. Never commit it.
#
#   cp deploy/prod.env.template prod.env && chmod 600 prod.env
#
# Sections are ordered by how much they matter:
#   1. REQUIRED — the app refuses to boot without these three.
#   2. IDENTITY — set before anyone prints a QR code.
#   3. FIRST DEPLOY — consumed once by `deploy.sh seed`.
#   4. PAYMENTS — set the ones you actually take money with.
#   5. OPTIONAL — safe to leave commented out.
#
# Generate secrets (run these, don't invent values):
#   SESSION_SECRET      openssl rand -base64 48
#   DB_OWNER_PASSWORD   openssl rand -hex 24      <- HEX, see below
#   ADMIN/OWNER pwds    openssl rand -base64 18
#
# DB_OWNER_PASSWORD must be HEX, not base64. It is interpolated into a
# connection URL, and base64's `/` and `+` (or a `#`, or an `@`) break
# URL parsing — Prisma fails with the deeply unhelpful
# "P1013 ... invalid port number in database URL", because the parser
# lost track of the authority section. Hex is alphanumeric, so it is
# always URL-safe. (SESSION_SECRET and the login passwords never go
# into a URL, so base64 is fine for those.)
# =====================================================================

NODE_ENV=production


# ---------------------------------------------------------------------
# 1. REQUIRED — validated at boot by src/lib/env.ts. A missing or short
#    value is a hard startup failure, not a warning.
# ---------------------------------------------------------------------

# Signs the session cookie. MINIMUM 32 characters — the schema rejects
# anything shorter. Rotating it logs every user out, which is the
# intended emergency lever.
SESSION_SECRET=

# Postgres. The app connects DIRECTLY to the remote managed database as
# the owner role: single restaurant, RLS disabled, no pooler.
# docker-compose.prod.yml builds APP_DATABASE_URL and DATABASE_URL from
# these four, so set these rather than the URLs.
DB_HOST=10.0.0.2                        # DB VPS private IP
DB_NAME=resto_database
DB_OWNER_USER=resto_user
# HEX ONLY — `openssl rand -hex 24`. A `/`, `+`, `#` or `@` here breaks
# the connection URL (see the note at the top of this file).
DB_OWNER_PASSWORD=

# Redis. Provided by the compose stack, so leave it alone unless you
# move Redis elsewhere. NOTE: Redis is required to BOOT but is not
# required to take an order — ordering and payment survive it being
# down (src/lib/rate-limit.ts), and webhook de-duplication lives in
# Postgres.
# REDIS_URL=redis://redis:6379


# ---------------------------------------------------------------------
# 2. IDENTITY — bake this in BEFORE printing QR codes. The full URL is
#    encoded into every printed code; changing the domain later breaks
#    every table tent already on the tables.
# ---------------------------------------------------------------------

APP_URL=https://menu.example.com
APP_DOMAIN=menu.example.com             # Caddy's TLS hostname (no scheme)
NEXT_PUBLIC_APP_BRAND_NAME="Rangla Punjab"
# NEXT_PUBLIC_APP_BRAND_TAGLINE="Authentic Punjabi kitchen"
# CURRENCY=EUR
# DEFAULT_LOCALE=de

# Built by `deploy/deploy.sh build`.
APP_IMAGE=rangla-app:latest


# ---------------------------------------------------------------------
# 3. FIRST DEPLOY ONLY — `deploy.sh seed` reads these to create the
#    operator login, the restaurant, and the owner login. After the
#    first successful seed, COMMENT THE PASSWORDS OUT so they are not
#    sitting in a file on the box.
# ---------------------------------------------------------------------

ADMIN_EMAIL=operator@example.com        # your /admin login
ADMIN_PASSWORD=
OWNER_EMAIL=owner@example.com           # the restaurant's /dashboard login
OWNER_PASSWORD=
RESTAURANT_NAME="Rangla Punjab"
RESTAURANT_SLUG=rangla-punjab           # public menu is served at /
TEMPLATE_KEY=indian-pakistani           # starter menu to apply


# ---------------------------------------------------------------------
# 4. PAYMENTS
#
# Everything here is OPTIONAL as far as booting goes — with none of it
# set the app runs in "pay at the restaurant" mode and the card/PayPal
# buttons simply do not appear. Set what you actually use.
#
# You can also enter Stripe and PayPal credentials from the Operator
# Console (/admin/settings) or the restaurant's own Payments page
# instead of here; keys entered there are encrypted at rest in the
# database and OVERRIDE these values. Per-restaurant keys are the
# better route — these env vars are the deployment-wide fallback.
# ---------------------------------------------------------------------

# --- Stripe (cards, Apple Pay, Google Pay) ---
# ⛔ LIVE KEYS MOVE REAL MONEY. Start with sk_test_… and run one
# €0.50 order end to end before switching.
# STRIPE_SECRET_KEY=sk_live_
# STRIPE_WEBHOOK_SECRET=whsec_             # endpoint: /api/stripe/webhook
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_     # endpoint: /api/stripe/own-webhook
# Publishable key — PUBLIC, not a secret: the phone app's native payment
# sheet needs it, and the server hands it to the app at payment time, so
# rotating it never requires an app-store release. Without it the app
# falls back to the hosted checkout page in a browser.
# STRIPE_PUBLISHABLE_KEY=pk_live_
#
# ⚠ WEBHOOK EVENTS: each endpoint above must subscribe to BOTH
#   checkout.session.completed  (payment on the hosted checkout page)
#   payment_intent.succeeded    (payment inside the phone app)
# An endpoint missing payment_intent.succeeded leaves in-app orders
# stuck on "pending" even though the card was charged.

# --- PayPal ---
# PAYPAL_ENV must be `live` for real payments; `sandbox` uses PayPal's
# test environment. Unset credentials ⇒ the in-memory fake, which is
# fine for a staging box and must never be used on a live domain.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live


# ---------------------------------------------------------------------
# 5. OPTIONAL
# ---------------------------------------------------------------------

# --- Transactional email (owner invites, verification, password reset) ---
# ⚠ SET THIS. Leaving EMAIL_TRANSPORT unset does NOT mean "no email" —
# it defaults to `mailhog`, which tries SMTP on localhost:1025. There is
# no MailHog on the VPS, so every invite and password reset fails with a
# connection error. Pick one:
#   resend   real delivery (needs RESEND_API_KEY; EU region available)
#   console  log the mail instead of sending it — fine for a menu-only
#            launch where nobody needs a password reset yet
# The Operator Console (/admin/settings) can override this at runtime.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_
EMAIL_FROM="Rangla Punjab <no-reply@menu.example.com>"

# --- Guest accounts via Google (optional) ---
# Without these, production has NO OAuth provider: guests sign in with
# email + password instead, and the mobile app's provider list is empty.
# Set them if you want one-tap sign-in in the app.
# Authorised redirect URI: https://<APP_DOMAIN>/api/auth/customer/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# One-tap sign-in in the mobile app needs THREE OAuth clients in the same
# Google Cloud project (Console → APIs & Services → Credentials). All of
# this is human work — the loop cannot create them:
#
#   1. Web application  — the pair above. Also the "server client id" the
#      native SDK is given, so the ID token it mints carries this `aud`
#      on Android.
#   2. iOS              — bundle id of the Expo app (see mobile/app.json
#      `ios.bundleIdentifier`). No secret.
#   3. Android          — package name (`android.package`) + the signing
#      certificate SHA-1 fingerprint. Debug builds and Play-signed builds
#      have DIFFERENT fingerprints; register both or sign-in fails on one
#      of them with a bare DEVELOPER_ERROR. Read the release fingerprint
#      from the Play Console (App integrity → App signing key), the debug
#      one from `keytool -list -v -keystore ~/.android/debug.keystore`
#      (password: android). No secret.
#
# List every client id whose tokens the backend should accept, comma
# separated — these are the allowed `aud` values for
# POST /api/auth/customer/google. Public identifiers, NOT secrets, but
# they must be ours: an unlisted id is rejected with 401. Unset ⇒ only
# GOOGLE_CLIENT_ID is accepted; neither set ⇒ the endpoint answers 503.
# GOOGLE_MOBILE_CLIENT_IDS=<ios-client-id>.apps.googleusercontent.com,<android-client-id>.apps.googleusercontent.com

# --- Image pipeline (defaults are right for one VPS) ---
# Resized variants are cached on disk on the `image_cache` volume.
# Derived data: not in the backup set, safe to delete, re-encodes on
# demand. SHARP_CONCURRENCY=1 keeps image work from starving request
# handling on a 1-2 vCPU box.
# IMAGE_CACHE_DIR=/app/.image-cache
# SHARP_CONCURRENCY=1

# --- Resilience tuning (defaults are deliberate) ---
# How long the rate limiter waits on Redis before falling back to its
# in-process counter. Low on purpose: ioredis retries ~8s before it
# gives up, and no guest should wait that long to place an order.
# RATE_LIMIT_REDIS_TIMEOUT_MS=250
# How long processed webhook ids are remembered (provider retry window).
# WEBHOOK_EVENT_RETENTION_DAYS=14
# Set to 0 to stop creating next month's table partitions at boot. Only
# do this if you run the maintenance from somewhere else — without it,
# audit writes start failing the month the partitions run out.
# PARTITION_MAINTENANCE_ON_BOOT=1

# --- Observability ---
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# INTERNAL_METRICS_TOKEN=                 # guards /api/internal/metrics

# --- Cloudflare cache purge ---
# Only if you later put Cloudflare in front. Not used otherwise: this
# deploy serves and caches its own images.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# --- Live logs in the browser (Dozzle) ---
# On by default at https://<APP_DOMAIN>/logs, login user "admin" with
# ADMIN_PASSWORD. For a separate login set both; deploy.sh hashes it with
# Dozzle's own generator (bcrypt) — never put a hash here yourself.
# DOZZLE_USER=owner
# DOZZLE_PASSWORD=
