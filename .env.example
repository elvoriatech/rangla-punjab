# resto — environment contract. Copy to .env and fill in.
# RULE: secrets + infra only. Per-client branding and restaurant data → prod.env / dashboard.
NODE_ENV=development

# ─── Brand (white-label) ────────────────────────────────────────────────
# Optional — defaults to "Resto" (see src/lib/brand.ts).
NEXT_PUBLIC_APP_BRAND_NAME="Resto"
# NEXT_PUBLIC_APP_BRAND_TAGLINE="Order online — fresh from our kitchen."

# ─── Database ───────────────────────────────────────────────────────────
# Single restaurant, RLS disabled: the app connects DIRECTLY to Postgres
# as the owner role — no connection pooler. In production this is the
# remote managed Postgres (e.g. rangla_database @ your DB host) over TLS.
APP_DATABASE_URL="postgresql://rangla_user:CHANGE_ME@localhost:5433/rangla-punjab-resturant?schema=public"
# Migrations/admin. Same Postgres as APP_DATABASE_URL (owner role).
DATABASE_URL="postgresql://rangla_user:CHANGE_ME@localhost:5433/rangla-punjab-resturant?schema=public"

# ─── Session ────────────────────────────────────────────────────────────
# HMAC key for signed httpOnly session cookies. Generate: openssl rand -base64 48
# NEVER reuse the dev value in production.
SESSION_SECRET="dev-only-do-not-use-in-prod-32-bytes-minimum-abcdefgh"

# ─── Payments (Stripe) ──────────────────────────────────────────────────
# Your PLATFORM Stripe account (Connect). Unset in dev/CI → the fake
# provider (src/lib/stripe/fake-provider.ts) drives every codepath.
# Live keys belong in the production secret store, never in git.
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"  # prod only
# Public identifier (not a secret) that the mobile app's native payment
# sheet needs; the app fetches it from POST /api/orders/{id}/pay/intent.
# STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxx"

# Apple Pay button in the GUEST WEB checkout (P7-13). Google Pay needs no
# extra setup; Apple requires the domain to be verified first (serve
# /.well-known/apple-developer-merchantid-domain-association and register
# the domain under Stripe → Settings → Payment methods → Apple Pay). Leave
# unset until that is done — the wallet button then only offers Google Pay.
# APPLE_PAY_WEB_ENABLED="true"

# PayPal — the restaurant normally pastes its own REST-app credentials in
# Dashboard → Payments; these are the deployment-wide fallback. Unset ⇒ the
# in-memory fake provider. PAYPAL_WEBHOOK_ID is the id PayPal shows after you
# register https://<domain>/api/paypal/webhook under the app's Webhooks.
# PAYPAL_CLIENT_ID="xxxxxxxxxxxxxxxx"
# PAYPAL_CLIENT_SECRET="xxxxxxxxxxxxxxxx"
# PAYPAL_ENV="sandbox"
# PAYPAL_WEBHOOK_ID="xxxxxxxxxxxxxxxx"
# Flat monthly operator support fee — a recurring Price id (in-app billing
# only; dev/CI ride the fake provider without it).
# STRIPE_PRICE_ID_SUPPORT="price_xxxxxxxxxxxxxxxx"

# ─── Transactional email ────────────────────────────────────────────────
# Dev/test → MailHog; prod → Resend. Owner invites, receipts, password resets.
EMAIL_TRANSPORT="mailhog"
EMAIL_FROM="Resto <dev@example.local>"
MAILHOG_SMTP_HOST="localhost"
MAILHOG_SMTP_PORT="1025"
MAILHOG_API_URL="http://localhost:8025"
# Required only when EMAIL_TRANSPORT=resend:
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# ─── Menu photos ─────────────────────────────────────────────────────────
# No object store / CDN. Uploaded photos are written to the app's own disk
# under public/uploads and resized on the fly by the /img route. Nothing to
# configure here — in prod, mount public/uploads as a volume and back it up.

# ─── Background jobs ────────────────────────────────────────────────────
# Rate-limit counters, webhook idempotency, and the maintenance crons.
REDIS_URL="redis://localhost:6379"

# ─── Public origin ──────────────────────────────────────────────────────
# Every absolute URL (QR codes, receipts, emails) derives from this.
APP_URL="http://localhost:3000"

# ─── Operator seed (used once by scripts/seed-platform-admin.ts) ─────────
# Required in production; dev falls back to a well-known local default.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-strong-12+char-password"

# ─── Optional integrations (unset = disabled) ───────────────────────────
# SENTRY_DSN="https://<key>@<host>/<project>"
# DATABASE_URL_READ="postgresql://elvoria_app:...@replica:5432/rangla-punjab-resturant?schema=public"
# INTERNAL_METRICS_TOKEN="generate-with-openssl-rand-base64-48"
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway.example/otlp"
# CLOUDFLARE_ZONE_ID="…"
# CLOUDFLARE_API_TOKEN="…"

# ─── Push notifications to the restaurant's phone (P7-11) ───────────────
# Unset ⇒ an in-memory fake records sends and nothing leaves the process
# (dev, CI, and any deploy without credentials). Turning this on requires
# the Apple push key + FCM service account uploaded to EAS first.
# EXPO_PUSH_ENABLED="true"
# EXPO_ACCESS_TOKEN="…"            # only if Expo's push security is on

# ─── Google rating + review link (P7-14) ────────────────────────────────
# Server-side Places API (New) key. Unset ⇒ no rating is ever fetched and
# no rating line appears anywhere (dev, CI, and any deploy without a key).
# The key is BILLABLE — enable the Places API and billing on the Google
# Cloud project first, and restrict the key to that one API. The venue's
# Place ID is an owner setting in Dashboard → Settings → Google, not here.
# GOOGLE_PLACES_API_KEY="AIza…"
