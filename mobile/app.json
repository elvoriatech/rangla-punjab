{
  "expo": {
    "orientation": "default",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "NFHFDX372C"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app uses your photos so you can attach a picture when you report a problem with an order.",
          "cameraPermission": "The app uses the camera so you can photograph a problem with your order instead of describing it."
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "brand": {
        "venueSlug": "rangla-punjab",
        "venueName": "Rangla Punjab",
        "themeId": "rangla-royal"
      },
      "eas": {
        "projectId": "dd669a2b-f955-43a5-bfce-a5d77106b00b"
      }
    },
    "owner": "zahoor1989"
  }
}
