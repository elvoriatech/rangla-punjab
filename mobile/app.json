        "venueSlug": "rangla-punjab",
        "venueName": "Rangla Punjab",
        "themeId": "rangla-royal"
      },
      "eas": {
        "projectId": "dd669a2b-f955-43a5-bfce-a5d77106b00b"
      }
    },
    "owner": "zahoor1989"
  }
}
