{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://rangla-punjab-restaurant.de" }
    },
    "preview-lan": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "http://REPLACE-WITH-THIS-MACS-LAN-IP:3000" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://rangla-punjab-restaurant.de" }
    }
  },
  "submit": { "production": {} }
}
