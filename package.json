    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.80.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
