    "seed:demo": "tsx scripts/seed-demo-venue.ts",
    "restore-drill": "tsx scripts/restore-drill.ts",
    "test:axe": "playwright test",
    "test:lhci": "lhci autorun",
    "worker": "tsx src/workers/menu-import.ts",
    "check:bundle": "tsx scripts/check-guest-bundle.ts",
    "purge:test-tenants": "tsx --env-file=.env scripts/purge-test-tenants.ts"
  },
  "dependencies": {
