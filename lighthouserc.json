{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": ["http://127.0.0.1:3000/"],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        },
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2700, "aggregationMethod": "median" }
        ],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 15360 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 15360 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 65536 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 294912 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 153600 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
